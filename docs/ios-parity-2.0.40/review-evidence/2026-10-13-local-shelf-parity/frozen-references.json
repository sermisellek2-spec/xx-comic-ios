            "    public static final int MARGIN_HORIZONTAL_DP = 16;",
            "    public static final int MARGIN_TOP_DP = 16;",
            "    public static final int MARGIN_BOTTOM_DP = 20;",
            "",
            "    public static final float DEFAULT_Y_FRACTION = 0.88f;",
            "    public static final boolean DEFAULT_SNAP_LEFT = false; // default to right edge",
            "",
            "    public static final String PREFS_NAME = \"xx-comic\";",
            "    public static final String PREF_SNAP_LEFT = \"floating_bubble_snap_left\";",
            "    public static final String PREF_Y_FRACTION = \"floating_bubble_y_fraction\";",
            "",
            "    public static class Geometry {",
            "        public final boolean isLeft;",
            "        public final float yFraction;",
            "        public final float x;",
            "        public final float y;",
            "",
            "        public Geometry(boolean isLeft, float yFraction, float x, float y) {",
            "            this.isLeft = isLeft;",
            "            this.yFraction = yFraction;",
            "            this.x = x;",
            "            this.y = y;",
            "        }",
            "    }",
            "",
            "    private final Listener listener;",
            "    private final int touchSlop;",
            "",
            "    private float downRawX;",
            "    private float downRawY;",
            "    private float initialX;",
            "    private float initialY;",
            "    private boolean isDragging = false;",
            "",
            "    public FloatingImportBubble(Context context, Listener listener) {",
            "        super(context);",
            "        this.listener = listener;",
            "        this.touchSlop = ViewConfiguration.get(context).getScaledTouchSlop();",
            "",
            "        initView();",
            "    }",
            "",
            "    private void initView() {",
            "        int size = UIHelpers.dp(getContext(), BUBBLE_SIZE_DP);",
            "",
            "        // Circular background with primary accent color",
            "        GradientDrawable bg = new GradientDrawable();",
            "        bg.setShape(GradientDrawable.OVAL);",
            "        bg.setColor(Color.rgb(43, 152, 217)); // UIHelpers.ACCENT",
            "        setBackground(bg);",
            "",
            "        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {",
            "            setElevation(UIHelpers.dp(getContext(), 6));",
            "            setClipToOutline(true);",
            "        }",
            ""
          ]
        },
        {
          "startLine": 200,
          "endLine": 270,
          "lines": [
            "        float marginH = UIHelpers.dp(getContext(), MARGIN_HORIZONTAL_DP);",
            "        float marginT = UIHelpers.dp(getContext(), MARGIN_TOP_DP);",
            "        float marginB = UIHelpers.dp(getContext(), MARGIN_BOTTOM_DP);",
            "",
            "        boolean snapLeft = loadPrefSnapLeft(getContext());",
            "        float yFraction = loadPrefYFraction(getContext());",
            "",
            "        Geometry geo = calculatePosition(snapLeft, yFraction, parentW, parentH, bubbleW, marginH, marginT, marginB);",
            "        setX(geo.x);",
            "        setY(geo.y);",
            "    }",
            "",
            "    // =========================================================================",
            "    // Pure calculation and geometry helpers (Static & 100% Unit Testable)",
            "    // =========================================================================",
            "",
            "    public static Geometry calculatePosition(boolean isSnapLeft,",
            "                                             float yFraction,",
            "                                             float parentWidth,",
            "                                             float parentHeight,",
            "                                             float bubbleSize,",
            "                                             float marginHorizontal,",
            "                                             float marginTop,",
            "                                             float marginBottom) {",
            "        float minX = marginHorizontal;",
            "        float maxX = Math.max(minX, parentWidth - bubbleSize - marginHorizontal);",
            "        float x = isSnapLeft ? minX : maxX;",
            "",
            "        float minY = marginTop;",
            "        float maxY = Math.max(minY, parentHeight - bubbleSize - marginBottom);",
            "        float clampedFraction = Math.max(0f, Math.min(1f, yFraction));",
            "        float y = minY + clampedFraction * (maxY - minY);",
            "",
            "        return new Geometry(isSnapLeft, clampedFraction, x, y);",
            "    }",
            "",
            "    public static boolean resolveSnapSide(float currentX, float bubbleSize, float parentWidth) {",
            "        float centerX = currentX + bubbleSize / 2f;",
            "        return centerX < (parentWidth / 2f);",
            "    }",
            "",
            "    public static float resolveYFraction(float currentY, float parentHeight, float bubbleSize,",
            "                                        float marginTop, float marginBottom) {",
            "        float minY = marginTop;",
            "        float maxY = Math.max(minY, parentHeight - bubbleSize - marginBottom);",
            "        if (maxY <= minY) return 1f;",
            "        float clampedY = Math.max(minY, Math.min(maxY, currentY));",
            "        return (clampedY - minY) / (maxY - minY);",
            "    }",
            "",
            "    public static void savePreferences(Context context, boolean isSnapLeft, float yFraction) {",
            "        if (context == null) return;",
            "        SharedPreferences prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);",
            "        prefs.edit()",
            "                .putBoolean(PREF_SNAP_LEFT, isSnapLeft)",
            "                .putFloat(PREF_Y_FRACTION, yFraction)",
            "                .apply();",
            "    }",
            "",
            "    public static boolean loadPrefSnapLeft(Context context) {",
            "        if (context == null) return DEFAULT_SNAP_LEFT;",
            "        SharedPreferences prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);",
            "        return prefs.getBoolean(PREF_SNAP_LEFT, DEFAULT_SNAP_LEFT);",
            "    }",
            "",
            "    public static float loadPrefYFraction(Context context) {",
            "        if (context == null) return DEFAULT_Y_FRACTION;",
            "        SharedPreferences prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);",
            "        return prefs.getFloat(PREF_Y_FRACTION, DEFAULT_Y_FRACTION);",
            "    }",
            "}"
          ]
        }
